# ─────────────────────────────────────────────────────────────────────────────
# CrewClock Environment Variables
# Copy to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Database + Auth (Supabase) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxx"
SUPABASE_SERVICE_ROLE_KEY="xxx"                    # server-only, never in client bundle
DATABASE_URL="postgresql://postgres:xxx@xxx.pooler.supabase.com:6543/postgres"       # pooled (pgbouncer), used at runtime
DATABASE_URL_UNPOOLED="postgresql://postgres:xxx@db.xxx.supabase.co:5432/postgres"   # direct, used by drizzle-kit generate/push/migrate

# ── Auth (Supabase, Expo/mobile) ─────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="xxx"
EXPO_PUBLIC_API_URL="http://localhost:3000"

# ── Cache & Queue (Upstash) ──────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"
QSTASH_URL="https://qstash.upstash.io"
QSTASH_TOKEN="xxx"
QSTASH_CURRENT_SIGNING_KEY="sig_xxx"
QSTASH_NEXT_SIGNING_KEY="sig_xxx"

# ── Real-time (Ably) ─────────────────────────────────────────────────────────
ABLY_API_KEY="xxx.xxx:xxx"
NEXT_PUBLIC_ABLY_API_KEY="xxx.xxx:xxx"

# ── File Storage (Cloudflare R2) ─────────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID="xxx"
CLOUDFLARE_R2_ACCESS_KEY_ID="xxx"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="xxx"
CLOUDFLARE_R2_BUCKET_NAME="crewclock"
CLOUDFLARE_R2_PUBLIC_URL="https://xxx.r2.dev"

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="noreply@crewclock.app"

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxx"
TWILIO_AUTH_TOKEN="xxx"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"

# ── Payments (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ── Maps (Mapbox) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN="pk.xxx"

# ── AI Models ────────────────────────────────────────────────────────────────
# Groq (free tier: llama-3.3-70b, fast inference)
GROQ_API_KEY="gsk_L05VVkR5xRI4wvzFtyyhWGdyb3FYTk7yROgSOV0zBZMOtIG4wXIn123"

# Anthropic Claude (paid — complex reasoning, payroll Q&A)
ANTHROPIC_API_KEY="sk-ant-xxx"

# Google Gemini (free tier fallback)
GOOGLE_GENERATIVE_AI_API_KEY="AIzaxxx"

# OpenAI embeddings (paid fallback)
OPENAI_API_KEY="sk-xxx"

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
